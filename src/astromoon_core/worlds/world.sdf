<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="lunar_world">
    <plugin
      filename="ignition-gazebo-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="ignition-gazebo-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="ignition-gazebo-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <ignition-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </ignition-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.5 0.5 0.5</ambient_light>
        <background_color>0 0 0</background_color>
        <camera_pose>-8 0 8 0 0.6 0</camera_pose>
      </plugin>

      <plugin filename="GzSceneManager" name="Scene Manager">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </ignition-gui>
      </plugin>

      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <ignition-gui>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="showTitleBar" type="bool">false</property>
        </ignition-gui>
      </plugin>

      <plugin filename="InteractiveViewControl" name="Camera Control">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </ignition-gui>
      </plugin>

      <plugin filename="CameraTracking" name="Camera Tracking">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </ignition-gui>
      </plugin>

      <plugin filename="WorldControl" name="World control">
        <ignition-gui>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </ignition-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
      </plugin>

      <plugin filename="WorldStats" name="World stats">
        <ignition-gui>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </ignition-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>

      <plugin filename="Teleop" name="Teleop">
        <ignition-gui>
          <title>Rover teleop</title>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">220</property>
          <property key="height" type="double">220</property>
          <property key="state" type="string">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
        </ignition-gui>
        <topic>/cmd_vel_manual</topic>
        <maxForwardVel>1.0</maxForwardVel>
        <maxVerticalVel>0.0</maxVerticalVel>
        <maxYawVel>0.8</maxYawVel>
      </plugin>

      <plugin filename="EntityTree" name="Entity tree">
        <ignition-gui>
          <property type="string" key="state">docked_collapsed</property>
        </ignition-gui>
      </plugin>
    </gui>

    <!-- Lune -->
    <gravity>0 0 -0.9</gravity>

    <!-- Scène: fond noir, grille OFF (si supporté) -->
    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0 0 0 1</background>
      <grid>false</grid>
    </scene>

    <!-- Soleil -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.3 0.5 -1</direction>
    </light>

    <!-- Sol lunaire via OBJ -->
    <model name="lunar_ground">
      <static>true</static>
      <pose>0 0 -10 0 0 0</pose>
      <link name="ground">
        <visual name="ground_visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <mesh>
              <uri>../meshes/lunar_ground/moon.obj</uri>
              <scale>10 10 10</scale>
            </mesh>
          </geometry>
          <double_sided>true</double_sided>
          <transparency>0</transparency>
          <!-- Matériau simple (pas de texture) pour éviter le rendu noir -->
          <material>
            <lighting>true</lighting>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>

        <!-- Collision mesh (simple) -->
        <collision name="col_mesh">
          <geometry>
            <mesh>
              <uri>../meshes/lunar_ground/moon.obj</uri>
              <scale>10 10 10</scale>
            </mesh>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Ciel étoilé: mesh géant, émissif, normals "inversées" via scale X négatif -->
    <model name="star_sky">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="sky">
        <visual name="sky_visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <mesh>
              <uri>../meshes/star_sky/stars.obj</uri>
              <!-- -X pour voir l'intérieur; augmente si besoin (500–1000) -->
              <scale>-1400 1400 1400</scale>
            </mesh>
          </geometry>
          <double_sided>true</double_sided>
          <transparency>0</transparency>
        </visual>
      </link>
    </model>

  </world>
</sdf>
